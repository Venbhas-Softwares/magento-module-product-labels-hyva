<?php
declare(strict_types=1);

namespace Venbhas\ProductLabelsHyva\Plugin\Block\Product\View;

use Magento\Catalog\Block\Product\View\Gallery;
use Magento\Framework\View\LayoutInterface;
use Magento\Store\Model\StoreManagerInterface;
use Venbhas\ProductLabels\Block\Product\Labels;
use Venbhas\ProductLabels\Model\Config;

class GalleryPlugin
{
    public function __construct(
        private readonly Config $config,
        private readonly LayoutInterface $layout,
        private readonly StoreManagerInterface $storeManager
    ) {
    }

    /**
     * Inject product labels into the Hyvä product gallery.
     */
    public function afterToHtml(Gallery $subject, string $result): string
    {
        $storeId = (int) $this->storeManager->getStore()->getId();

        if ($result === '' || !$this->config->isEnabled($storeId)) {
            return $result;
        }

        $product = $subject->getProduct();
        if (!$product || !$product->getId()) {
            return $result;
        }

        if (!(int) $product->getStoreId()) {
            $product->setStoreId($storeId);
        }

        /** @var Labels $labelsBlock */
        $labelsBlock = $this->layout->createBlock(Labels::class);
        $labelsBlock->setProduct($product);

        if ($labelsBlock->getLabels() === []) {
            return $result;
        }

        $labelsHtml = $labelsBlock->toHtml();
        if ($labelsHtml === '') {
            return $result;
        }

        return '<div class="vp-label-wrapper relative">'
            . $result
            . $labelsHtml
            . '</div>';
    }
}
